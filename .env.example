# Copy to .env.local for local development. Every variable is optional.

# --- Data source (deployed) ---------------------------------------------
# Read the JSON the GitHub Actions jobs publish to the `data` branch.
# Leave unset locally to use the FastAPI backend on http://localhost:8000.
DATA_BASE_URL=https://raw.githubusercontent.com/NamanSharma2112/CrudeOilPrediction/data
# DATA_READ_TOKEN=        # only if the repo is private (read-only Contents token)
# FASTAPI_URL=            # only if you host the FastAPI service yourself

# --- Optional sign-in (Auth.js) ------------------------------------------
# Sign-in stays hidden behind a "not set up" notice until AUTH_SECRET and at
# least one provider are set. Generate a secret with: npx auth secret
# AUTH_SECRET=
# GitHub OAuth app (github.com/settings/developers → New OAuth App)
#   Callback URL: https://<your-domain>/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Google OAuth client (console.cloud.google.com → Credentials)
#   Redirect URI: https://<your-domain>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
